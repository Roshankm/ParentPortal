@inherits LayoutComponentBase
@implements IDisposable
@inject DemoSession Session
@inject NavigationManager Nav

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 gap-3">
            @if (Session.CurrentUser is { } user)
            {
                <span class="text-muted small">
                    <i class="bi bi-person-circle"></i>
                    <strong>@user.Name</strong> &middot; @user.Role &middot; @user.SchoolName
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="SwitchUser">Switch user</button>
            }
            <a href="https://github.com/Roshankm/ParentPortal" target="_blank" rel="noopener">
                <i class="bi bi-github"></i> Source
            </a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Session.Changed += OnSessionChanged;
            await Session.EnsureLoadedAsync();
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task SwitchUser()
    {
        await Session.SignOutAsync();
        Nav.NavigateTo("/");
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}

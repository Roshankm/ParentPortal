@implements IDisposable
@inject DemoSession Session

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href=""><i class="bi bi-mortarboard-fill"></i> ParentPortal</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill me-2"></i> Home
            </NavLink>
        </div>

        @if (Session.IsSignedIn)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="announcements">
                    <i class="bi bi-megaphone-fill me-2"></i> Announcements
                </NavLink>
            </div>

            @if (Session.CanAuthor)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="announcements/new">
                        <i class="bi bi-pencil-square me-2"></i> New announcement
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="classrooms">
                    <i class="bi bi-people-fill me-2"></i> Classrooms
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnChanged;
}
